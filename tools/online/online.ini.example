# Local wireless over the internet (runtime/ldn_online.inc). Copy this file to build\config\online.ini and fill it in.
# Without a server and a room the game behaves as before: local wireless reports "wireless off".
#
# server: the address of a room server (tools/online/ldn_room_server.py), host:port. TCP and UDP on that port must be open.
# room:   the room password. Players with the same password see each other's rooms; anyone else does not.
# name:   your name in the server's log (the game shows your console nickname, SSBU_NICKNAME or the Windows user name).
server = your.server.example:39010
room = choose-a-password
name = player
